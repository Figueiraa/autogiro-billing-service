# Copie para .env (que fica fora do git) e ajuste os valores.
SERVICE_NAME=billing-service

# Mesmo segredo da Lambda autogiro-auth e do Kong; no mínimo 32 caracteres.
JWT_SECRET=troque-por-um-segredo-com-32-caracteres-ou-mais

LOG_LEVEL=INFO
CORS_ORIGINS=*

# Banco e mensageria.
DATABASE_URL=postgresql+asyncpg://autogiro:autogiro@db:5432/autogiro_billing
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Mercado Pago (Checkout Pro). Credenciais de teste da aplicação; sem token,
# aprovar um orçamento responde 502.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_CHECKOUT_LINK=init_point

# Prazos: resposta ao orçamento, pagamento e consulta ao Mercado Pago.
APPROVAL_TIMEOUT_MINUTES=1440
PAYMENT_TIMEOUT_MINUTES=60
PAYMENT_POLL_SECONDS=15
