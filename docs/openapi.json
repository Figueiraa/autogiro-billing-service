          "reference_id": {
            "type": "integer",
            "title": "Reference Id"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "quantity": {
            "type": "integer",
            "title": "Quantity"
          },
          "unit_price": {
            "type": "number",
            "title": "Unit Price"
          },
          "subtotal": {
