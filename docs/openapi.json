          "order_id": {
            "type": "integer",
            "title": "Order Id"
          },
          "status": {
            "$ref": "#/components/schemas/BudgetStatus"
          },
          "total": {
            "type": "number",
            "title": "Total"
          },
          "client_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Name"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "decided_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Decided At"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/BudgetLineResponse"
            },
            "type": "array",
            "title": "Lines"
          }
        },
        "type": "object",
        "required": [
          "budget_id",
          "order_id",
          "status",
          "total",
          "client_name",
          "created_at",
          "expires_at",
          "decided_at",
          "lines"
        ],
        "title": "BudgetResponse"
      },
      "BudgetStatus": {
        "type": "string",
        "enum": [
          "PENDENTE",
          "APROVADO",
          "RECUSADO",
          "EXPIRADO",
          "CANCELADO"
        ],
        "title": "BudgetStatus"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LineKind": {
        "type": "string",
        "enum": [
          "SERVICO",
          "PECA"
        ],
        "title": "LineKind"
      },
      "PaymentResponse": {
        "properties": {
          "payment_id": {
            "type": "integer",
            "title": "Payment Id"
          },
          "order_id": {
            "type": "integer",
            "title": "Order Id"
          },
          "status": {
            "$ref": "#/components/schemas/PaymentStatus"
          },
          "amount": {
            "type": "number",
            "title": "Amount"
          },
          "payment_link": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Payment Link"
          },
          "mp_payment_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mp Payment Id"
          },
          "status_detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status Detail"
          },
          "refund_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Refund Id"
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          }
        },
        "type": "object",
        "required": [
          "payment_id",
          "order_id",
          "status",
          "amount",
          "payment_link",
          "mp_payment_id",
          "status_detail",
          "refund_id",
          "expires_at"
        ],
        "title": "PaymentResponse"
      },
      "PaymentStatus": {
        "type": "string",
        "enum": [
          "PENDENTE",
          "APROVADO",
          "RECUSADO",
          "EXPIRADO",
          "CANCELADO",
          "ESTORNADO",
          "ESTORNO_PENDENTE"
        ],
        "title": "PaymentStatus"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "description": "JWT emitido por autogiro-auth",
        "scheme": "bearer"
      }
    }
  }
