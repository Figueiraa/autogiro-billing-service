      "post": {
        "tags": [
          "Orçamentos"
        ],
        "summary": "Reject",
        "description": "Recusa o orçamento: a Saga libera as peças e cancela a OS.",
        "operationId": "reject_api_v1_budgets__order_id__reject_post",
        "security": [
          {
            "HTTPBearer": []
          }
