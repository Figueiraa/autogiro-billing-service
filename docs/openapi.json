    "schemas": {
      "ApprovalResponse": {
        "properties": {
          "order_id": {
            "type": "integer",
            "title": "Order Id"
          },
          "budget_status": {
            "$ref": "#/components/schemas/BudgetStatus"
          },
          "amount": {
            "type": "number",
            "title": "Amount"
          },
          "payment_link": {
            "type": "string",
            "title": "Payment Link"
          },
          "payment_expires_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Payment Expires At"
          }
        },
        "type": "object",
        "required": [
          "order_id",
          "budget_status",
          "amount",
          "payment_link",
          "payment_expires_at"
        ],
        "title": "ApprovalResponse"
      },
      "BudgetLineResponse": {
